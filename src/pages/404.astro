---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
---

<BaseLayout title="Página não encontrada" description="A página que você procura não existe." noindex>
  <PageHero
    eyebrow="Erro 404"
    title="Parece que perdemos o norte."
    lead="A página que você procura não existe ou mudou de endereço. Volte para o início ou fale direto com a gente."
    secondary={{ label: 'Voltar para o início', href: '/' }}
  />
</BaseLayout>
