---
import CompassMark from './CompassMark.astro';
interface Props {
  tone?: 'brand' | 'light';
  class?: string;
}
const { tone = 'brand', class: className = '' } = Astro.props;
const light = tone === 'light';
---

<span class:list={['inline-flex items-center gap-3', className]}>
  <CompassMark class="size-10 shrink-0" tone={tone} />
  <span class="flex flex-col leading-none">
    <span class:list={['font-display text-[1.35rem] font-bold tracking-tight', light ? 'text-white' : 'text-navy-800']}>
      Northpoint
    </span>
    <span class:list={['my-1 h-px w-full', light ? 'bg-white/30' : 'bg-navy-800/25']}></span>
    <span class:list={['font-display text-[0.7rem] font-normal tracking-[0.06em]', light ? 'text-steel-200' : 'text-navy-700']}>
      Global Holding
    </span>
  </span>
</span>
