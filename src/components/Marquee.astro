---
import CompassMark from './CompassMark.astro';
const items = ['Consultoria Mercado Livre', 'Gestão de conta', 'Criação de anúncios', 'Mercado Ads', 'Armazenagem', 'Envios no prazo', 'Fulfillment em São Paulo'];
---

<div class="relative overflow-hidden border-y border-silver-200 bg-white py-5" aria-label="Serviços Northpoint">
  <div class="np-marquee flex w-max gap-10">
    {[0, 1].map((dup) => (
      <ul class="flex shrink-0 items-center gap-10" aria-hidden={dup === 1 ? 'true' : undefined}>
        {items.map((i) => (
          <li class="flex items-center gap-10 whitespace-nowrap font-display text-sm font-semibold uppercase tracking-[0.18em] text-navy-700 sm:text-base">
            {i}
            <CompassMark class="size-5 opacity-60" />
          </li>
        ))}
      </ul>
    ))}
  </div>
  <div class="pointer-events-none absolute inset-y-0 left-0 w-16 bg-gradient-to-r from-white sm:w-32"></div>
  <div class="pointer-events-none absolute inset-y-0 right-0 w-16 bg-gradient-to-l from-white sm:w-32"></div>
</div>
