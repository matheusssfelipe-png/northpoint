---
import HeroBackdrop from './HeroBackdrop.astro';
import CompassMark from './CompassMark.astro';
import AnimatedTitle from './AnimatedTitle.astro';
import Icon from './Icon.astro';
import WaIcon from './WaIcon.astro';
import { waLink } from '../data/site';
interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  whatsappMessage?: string;
  ctaLabel?: string;
  bullets?: string[];
  secondary?: { label: string; href: string };
}
const {
  eyebrow,
  title,
  lead,
  whatsappMessage,
  ctaLabel = 'Falar com especialista',
  bullets,
  secondary = { label: 'Solicitar proposta', href: '#contato' },
} = Astro.props;
---

<section id="inicio" class="on-dark relative isolate overflow-hidden pb-20 pt-32 text-white md:pb-32 md:pt-48">
  <HeroBackdrop />
  <CompassMark tone="light" animated class="absolute -right-28 top-20 size-80 opacity-[0.08] lg:-right-24 lg:top-24 lg:size-[30rem]" />
  <div class="container-np relative">
    <p class="eyebrow np-in">{eyebrow}</p>
    <AnimatedTitle text={title} class="mt-6 max-w-4xl text-[2.35rem] font-bold leading-[1.08] sm:text-5xl lg:text-6xl" />
    <p class="np-in mt-6 max-w-2xl text-lg leading-relaxed text-steel-200/85" style="--d:350ms">{lead}</p>
    <div class="np-in mt-9 flex flex-col gap-3 sm:flex-row" style="--d:500ms">
      <a href={waLink(whatsappMessage)} target="_blank" rel="noopener" class="btn btn-wa py-4 text-base">
        <WaIcon class="size-5" /> {ctaLabel}
      </a>
      <a href={secondary.href} class="btn btn-ghost py-4 text-base">{secondary.label} <Icon name="arrow" class="size-4" /></a>
    </div>
    {bullets && (
      <ul class="np-in mt-6 flex flex-wrap gap-x-6 gap-y-2 text-sm text-steel-200/80" style="--d:650ms">
        {bullets.map((b) => <li class="flex items-center gap-2"><Icon name="check" class="size-4 text-steel-400" />{b}</li>)}
      </ul>
    )}
  </div>
</section>
