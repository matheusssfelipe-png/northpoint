---
import WaIcon from './WaIcon.astro';
import CompassMark from './CompassMark.astro';
import { waLink, homeAnchor } from '../data/site';
interface Props {
  title: string;
  text?: string;
  whatsappMessage?: string;
  secondary?: { label: string; href: string };
}
const { title, text, whatsappMessage, secondary } = Astro.props;
const second = secondary ?? { label: 'Fazer diagnóstico rápido', href: homeAnchor(Astro.url.pathname, 'diagnostico') };
---

<section class="container-np py-10 md:py-16">
  <div class="on-dark relative isolate overflow-hidden rounded-3xl bg-navy-800 px-6 py-12 text-white sm:px-12 md:py-16" data-reveal>
    <div class="absolute inset-0 -z-10 bg-[radial-gradient(ellipse_at_80%_0%,#2f5a8f_0%,transparent_60%)] opacity-70"></div>
    <CompassMark tone="light" class="absolute -right-20 -top-20 -z-10 size-80 opacity-[0.07]" />
    <div class="flex flex-col gap-8 lg:flex-row lg:items-center lg:justify-between">
      <div class="max-w-2xl">
        <h2 class="text-2xl font-bold leading-tight sm:text-3xl lg:text-4xl">{title}</h2>
        {text && <p class="mt-4 text-steel-200/80 sm:text-lg">{text}</p>}
      </div>
      <div class="flex flex-col gap-3 sm:flex-row lg:shrink-0">
        <a href={waLink(whatsappMessage)} target="_blank" rel="noopener" class="btn bg-[#25D366] text-white hover:-translate-y-0.5 hover:shadow-lg">
          <WaIcon class="size-5" /> Chamar no WhatsApp
        </a>
        <a href={second.href} class="btn btn-ghost">{second.label}</a>
      </div>
    </div>
  </div>
</section>
