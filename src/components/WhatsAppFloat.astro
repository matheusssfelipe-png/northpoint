---
import { waLink, homeAnchor } from '../data/site';
import WaIcon from './WaIcon.astro';
import Icon from './Icon.astro';
const quizHref = homeAnchor(Astro.url.pathname, 'diagnostico');
---

<!-- Desktop: botão flutuante -->
<a
  href={waLink()}
  target="_blank"
  rel="noopener"
  data-track="flutuante"
  class="btn btn-wa fixed bottom-6 right-6 z-30 hidden py-3 pl-4 pr-5 lg:flex"
>
  <span class="relative grid place-items-center">
    <span class="absolute size-8 animate-ping rounded-full bg-white/40 [animation-duration:2.6s] motion-reduce:hidden"></span>
    <WaIcon class="relative size-6" />
  </span>
  Fale com a gente
</a>

<!-- Mobile: barra fixa de ação no rodapé; aparece após o topo e some perto do formulário e do rodapé -->
<div
  data-mobile-cta
  class="invisible fixed inset-x-0 bottom-0 z-30 translate-y-full border-t border-silver-200/80 bg-white px-4 shadow-[0_-8px_30px_-12px_rgba(15,35,65,0.15)] pb-[calc(env(safe-area-inset-bottom)+12px)] pt-3 transition-[translate,visibility] duration-500 ease-out-soft data-[visible]:visible data-[visible]:translate-y-0 lg:hidden"
>
  <div class="mx-auto flex max-w-md gap-2">
    <a href={waLink()} target="_blank" rel="noopener" class="btn btn-wa flex-1 px-3 py-3 shadow-none">
      <WaIcon class="size-5" /> WhatsApp
    </a>
    <a href={quizHref} class="btn flex-1 whitespace-nowrap bg-navy-800 px-3 py-3 text-white">
      <Icon name="compass" class="size-5" /> Diagnóstico
    </a>
  </div>
</div>
