---
import { waLink } from '../data/site';
import WaIcon from './WaIcon.astro';
import Icon from './Icon.astro';
const quizHref = Astro.url.pathname === '/' ? '#diagnostico' : '/#diagnostico';
---

<!-- Desktop: botão flutuante -->
<a
  href={waLink()}
  target="_blank"
  rel="noopener"
  aria-label="Conversar no WhatsApp"
  class="group fixed bottom-6 right-6 z-30 hidden items-center gap-3 rounded-full bg-[#25D366] py-3 pl-4 pr-5 text-white shadow-xl shadow-black/20 transition-all duration-500 ease-out-soft hover:-translate-y-0.5 hover:shadow-2xl lg:flex"
>
  <span class="relative grid place-items-center">
    <span class="absolute size-8 animate-ping rounded-full bg-white/30 [animation-duration:2.6s] motion-reduce:hidden"></span>
    <WaIcon class="relative size-6" />
  </span>
  <span class="font-display text-sm font-semibold">Fale com a gente</span>
</a>

<!-- Mobile: barra fixa de ação no rodapé, aparece após o hero -->
<div
  data-mobile-cta
  class="fixed inset-x-0 bottom-0 z-30 translate-y-full border-t border-silver-200/80 bg-white/90 px-4 pb-[calc(env(safe-area-inset-bottom)+12px)] pt-3 backdrop-blur-xl transition-transform duration-500 ease-out-soft data-[visible]:translate-y-0 lg:hidden"
>
  <div class="mx-auto flex max-w-md gap-2">
    <a href={waLink()} target="_blank" rel="noopener" class="btn flex-1 bg-[#25D366] px-3 py-3 text-white">
      <WaIcon class="size-5" /> WhatsApp
    </a>
    <a href={quizHref} class="btn flex-1 whitespace-nowrap bg-navy-800 px-3 py-3 text-white">
      <Icon name="compass" class="size-5" /> Diagnóstico
    </a>
  </div>
</div>
