---
import '@fontsource-variable/montserrat';
import '@fontsource-variable/inter';
import montserratLatin from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { site, cleanPath } from '../data/site';

interface Crumb { name: string; path: string }
interface Props {
  title: string;
  description: string;
  /** Schemas extras (Service, FAQPage...) além da organização. */
  schema?: Record<string, unknown>[];
  breadcrumbs?: Crumb[];
  noindex?: boolean;
}

const { title, description, schema = [], breadcrumbs, noindex = false } = Astro.props;
const path = cleanPath(Astro.url.pathname);
const canonical = new URL(path, Astro.site).href;
const fullTitle = title.includes(site.shortName) ? title : `${title} | ${site.shortName}`;
const ogImage = new URL('/og.png', Astro.site).href;
const orgId = new URL('/#organizacao', Astro.site).href;
const robots = noindex || !site.launched ? 'noindex, follow' : 'index, follow, max-image-preview:large';
const gtmId = site.analytics.gtmId;

const organization = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': orgId,
  name: site.name,
  alternateName: site.shortName,
  url: new URL('/', Astro.site).href,
  logo: new URL('/logo.png', Astro.site).href,
  image: ogImage,
  description: site.description,
  email: site.contact.email,
  telephone: `+${site.contact.whatsapp}`,
  ...(site.contact.instagram && { sameAs: [site.contact.instagram] }),
  address: { '@type': 'PostalAddress', addressLocality: site.city, addressRegion: site.region, addressCountry: site.country },
  areaServed: [
    { '@type': 'City', name: 'São Paulo' },
    { '@type': 'Country', name: 'Brasil' },
  ],
  knowsAbout: ['Mercado Livre', 'Fulfillment', 'Mercado Ads', 'Gestão de marketplace', 'Logística para e-commerce'],
};

const breadcrumbSchema = breadcrumbs && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [{ name: 'Início', path: '/' }, ...breadcrumbs].map((c, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: c.name,
    item: new URL(c.path, Astro.site).href,
  })),
};

const schemas = [organization, ...schema, ...(breadcrumbSchema ? [breadcrumbSchema] : [])];
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#0f2341" />
    <link rel="preload" href={montserratLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Northpoint: consultoria e fulfillment para Mercado Livre" />
    <meta name="twitter:card" content="summary_large_image" />

    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <script is:inline>document.documentElement.classList.add('js');</script>
    {gtmId && (
      <script is:inline define:vars={{ gtmId }}>
        (function (w, d, s, l, i) {
          w[l] = w[l] || [];
          w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var f = d.getElementsByTagName(s)[0], j = d.createElement(s);
          j.async = true;
          j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i;
          f.parentNode.insertBefore(j, f);
        })(window, document, 'script', 'dataLayer', gtmId);
      </script>
    )}
  </head>
  <body class="min-h-dvh overflow-x-clip">
    <a href="#conteudo" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded-full focus:bg-white focus:px-4 focus:py-2">
      Pular para o conteúdo
    </a>
    <Header />
    <main id="conteudo">
      <slot />
    </main>
    <Footer />
    <WhatsAppFloat />
    <script>
      import { initMotion } from '../scripts/motion';
      initMotion();
    </script>
  </body>
</html>
